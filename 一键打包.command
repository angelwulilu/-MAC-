#!/bin/bash
# ============================================================================
#  视频工具 Mac 版 —— 一键打包
#
#  用法：在 macOS 上【双击本文件】即可，不用打开终端敲命令。
#
#  第一次双击可能被系统拦住（提示「无法打开，因为来自身份不明的开发者」）：
#      右键点本文件 → 选择「打开」→ 在弹窗里再点一次「打开」
#  之后就能正常双击了。
#
#  如果双击完全没反应，可能是文件丢了可执行权限（从 Windows 压缩包解压过来
#  常见），在本文件夹里开终端跑一次下面这句就好：
#      chmod +x 一键打包.command
# ============================================================================

# 切到本脚本所在目录（双击时工作目录是用户主目录，不是这里）
cd "$(dirname "$0")" || exit 1

clear
echo "============================================================"
echo "   视频工具 Mac 版 —— 一键打包"
echo "============================================================"
echo ""
echo "  当前目录：$(pwd)"
echo ""

if [ ! -f "打包mac.sh" ]; then
    echo "❌ 找不到 打包mac.sh"
    echo ""
    echo "   请确认本文件是和 打包mac.sh 放在同一个文件夹里的。"
    echo ""
    echo "（按回车关闭窗口）"
    read -r _
    exit 1
fi

echo "  说明：默认会同时备好 Apple 芯片(arm64) 和 Intel 两版 ffmpeg，"
echo "       打出来的包谁的 Mac 都能跑（体积约 243MB）。"
echo ""
echo "  如果你确定对方是 Apple 芯片、想省 50MB，"
echo "  可以不要双击，改用终端跑：bash 打包mac.sh --one"
echo ""
echo "------------------------------------------------------------"
echo ""

# 直接用 bash 调用，所以本文件有没有 x 位都能跑。
#
# ⚠️ 打包mac.sh 里有 `set -e`（任何一步失败立刻退出），而且失败路径是 `die()`
#    → 直接 `exit 1`。如果这里用 `bash 打包mac.sh` 直接调，脚本一 exit 就轮到
#    本文件了 —— 但 `set -e` 只在**子 shell 内部**生效，父脚本（本文件）不受影响，
#    所以下面的 RC=$? / 报错提示都能正常执行。这里显式兜一层 set +e，
#    是为了防「本文件被别处 source / 用 bash -e 调用」时提前退出。
set +e
bash 打包mac.sh
RC=$?
set -e >/dev/null 2>&1 || true

echo ""
echo "------------------------------------------------------------"
if [ $RC -eq 0 ]; then
    echo "✅ 打包结束。产物在 dist/ 文件夹里：视频工具.app"
    echo ""
    # 顺手把 dist 目录在访达里打开，省得自己找
    if [ -d "dist" ]; then
        open "dist"
    fi
else
    echo "❌ 打包过程中出错了（退出码 $RC）"
    echo ""
    echo "   把上面从「打包开始」到这里的完整输出截图发我，我来看看。"
fi

echo ""
echo "（按回车关闭窗口）"
read -r _
