# ───────────────────────────────────────────────────────────────────────
#  Mac 版工程 —— 推 GitHub 前挡住不该传的东西
#
#  ⚠️ 这里每一条都不是"洁癖"，是**真的会出问题**：
#     · __pycache__/*.pyc  → 在 Windows 上生成的字节码，Mac 上没用还可能被误加载
#     · build/dist         → PyInstaller 产物，几百 MB，CI 会自己重新生成
#     · _bundled_ffmpeg    → 打包脚本临时下的 ffmpeg（约 93MB），CI 自己会下
#     · _alt / *.zip       → 另一架构备胎、成品包，都太大
# ───────────────────────────────────────────────────────────────────────

# Python 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller 产物
build/
dist/
*.spec.bak

# 虚拟环境
.venv/
venv/
env/
ENV/

# 打包脚本的临时目录（ffmpeg 下载缓存等）
_bundled_ffmpeg/
_alt/

# 打包/分发产物
*.zip
*.dmg
*.icns
*.iconset/

# 运行期产物
自检报告.txt
崩溃日志.txt
打包日志.txt
log/
config.json

# macOS 系统文件
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# Windows 系统文件（在 Windows 上编辑时会生成）
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk

# 编辑器
.vscode/
.idea/
*.swp
*~
